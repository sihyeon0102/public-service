        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"public-service\",application=\"public-service\",area=\"heap\"})",
          "legendFormat": "used",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "public-service-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_committed_bytes{job=\"public-service\",application=\"public-service\",area=\"heap\"})",
          "legendFormat": "committed",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "public-service-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum(jvm_memory_max_bytes{job=\"public-service\",application=\"public-service\",area=\"heap\"} >= 0)",
          "legendFormat": "max",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "public-service-prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
